SUBSTACK_SID=
PORT=5179
# LLM providers (shared service keys — never user-supplied). First key present
# in LLM_ORDER serves; daily-cap exhaustion AND transient 5xx/network errors
# fail over to the next. Gemini leads: the quality gate found Groq repeatedly
# "fixing" correct prose (voice violations), Gemini staying silent — for a
# typos-only tool a missed fix beats a wrong edit. With no keys, heuristic
# demo mode runs.
LLM_ORDER=gemini,groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Service account for the contributor model (falls back to SUBSTACK_SID).
REVIEWER_SID=
# Email of the reviewer account, shown in the contributor invite tutorial.
REVIEWER_EMAIL=
# Shown in the contributor tutorial if the writer gets stuck (optional).
SUPPORT_EMAIL=
# Password gate for the read-only admin route (#admin). Unset = admin disabled.
ADMIN_PASSWORD=
