SUBSTACK_SID=
PORT=5179
# LLM providers. First provider in LLM_ORDER serves; daily-cap exhaustion AND
# transient 5xx/network errors fail over to the next. Default opencode,gemini,groq:
# OpenCode's free model leads (uncapped), Gemini/Groq cover its misses and are
# used if the CLI is absent. Each provider's own key (opencode has none: the CLI
# is the credential). With nothing usable, heuristic demo mode runs.
LLM_ORDER=opencode,gemini,groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenCode (free tier). Not an HTTP endpoint: this provider drives a local
# headless `opencode serve` so the model is used "within OpenCode" — the
# Console free tier rejects direct calls from other clients. It needs the
# `opencode` CLI installed and logged in; add "opencode" to LLM_ORDER (e.g.
# `opencode,gemini,groq`) to use it. No key of its own.
# OPENCODE_BIN=                      # path to the CLI (else ~/.opencode/bin/opencode)
# OPENCODE_MODEL=deepseek-v4.1-flash-free
# OPENCODE_PORT=5198                 # headless server port (reused across runs)
# OPENCODE_URL=                      # attach to an already-running server instead
# Service account for the contributor model (falls back to SUBSTACK_SID).
REVIEWER_SID=
# Email of the reviewer account, shown in the contributor invite tutorial.
REVIEWER_EMAIL=
# Shown in the contributor tutorial if the writer gets stuck (optional).
SUPPORT_EMAIL=
# Optional durable path for sign-in sessions and temporary verification drafts.
# Defaults to data/auth-state.json; use persistent storage when hosting.
# AUTH_STATE_PATH=
# Verification drafts expire after 15 minutes. Session lifetime is 12 hours.
# Password gate for the read-only admin route (#admin). Unset = admin disabled.
ADMIN_PASSWORD=
