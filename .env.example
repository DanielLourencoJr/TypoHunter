SUBSTACK_SID=
PORT=5179
# LLM providers (shared service keys — never user-supplied). First key present
# in LLM_ORDER serves; daily-cap exhaustion fails over to the next.
# TEMPORARY order groq,gemini until the Gemini quality gate passes.
# With no keys at all, heuristic demo mode runs.
LLM_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Service account for the contributor model (falls back to SUBSTACK_SID).
REVIEWER_SID=
# Email of the reviewer account, shown in the contributor invite tutorial.
REVIEWER_EMAIL=
# Shown in the contributor tutorial if the writer gets stuck (optional).
SUPPORT_EMAIL=
# Password gate for the read-only admin route (#admin). Unset = admin disabled.
ADMIN_PASSWORD=
