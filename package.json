{
  "name": "typohunter",
  "version": "0.1.0",
  "description": "TypoHunter: local-first web reviewer for Substack drafts: diff approve, versioning, push back via direct SID",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test e2e/*.test.mjs",
    "test:hosted:ui": "BASE_URL=${BASE_URL:-https://typohunter.onrender.com} node --test e2e/auth-slides.playwright.test.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright": "^1.55.1"
  }
}
